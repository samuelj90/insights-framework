{
  "version": "2",
  "guidance": "Choose a horizontal bar chart to compare one numeric measure across categories. Only use the provided field names. Do not invent fields or provide data. Return a JSON object with kind, x, y, and rationale.",
  "proposal_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind",
      "x",
      "y",
      "rationale"
    ],
    "properties": {
      "kind": {
        "const": "bar"
      },
      "x": {
        "type": "string",
        "minLength": 1
      },
      "y": {
        "type": "string",
        "minLength": 1
      },
      "rationale": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "dashboard_guidance": "Compose a dashboard from governed query plans. Each tile chooses one kind and one plan whose shape satisfies that kind: metrics is the number of plan metrics, groups counts plan dimensions plus the time dimension, time says whether time_dimension with time_grain is required, optional or forbidden, and additive kinds need count or sum metrics. Start with KPI tiles for headline totals, then trends, comparisons, composition and detail. Prefer the simplest kind that answers the question. Never provide data values; the platform runs each plan and binds the result.",
  "kinds": {
    "kpi": {
      "family": "single",
      "use": "A single headline number, such as a total count or sum.",
      "metrics": [
        1,
        1
      ],
      "groups": [
        0,
        0
      ],
      "time": "forbidden",
      "additive": false,
      "size": {
        "w": 3,
        "h": 1
      }
    },
    "bar": {
      "family": "category",
      "use": "Rank or compare categories, especially many or long labels.",
      "metrics": [
        1,
        1
      ],
      "groups": [
        1,
        1
      ],
      "time": "forbidden",
      "additive": false,
      "size": {
        "w": 6,
        "h": 2
      }
    },
    "column": {
      "family": "category",
      "use": "Compare a few categories with short labels.",
      "metrics": [
        1,
        1
      ],
      "groups": [
        1,
        1
      ],
      "time": "forbidden",
      "additive": false,
      "size": {
        "w": 6,
        "h": 2
      }
    },
    "donut": {
      "family": "category",
      "use": "Part-to-whole share across at most six categories.",
      "metrics": [
        1,
        1
      ],
      "groups": [
        1,
        1
      ],
      "time": "forbidden",
      "additive": true,
      "size": {
        "w": 4,
        "h": 2
      }
    },
    "treemap": {
      "family": "category",
