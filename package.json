{
  "name": "visual-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite demo --host 127.0.0.1 --config vite.config.ts",
    "build": "tsc -p tsconfig.lib.json && vite build demo --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src demo tests playwright.config.ts vite.config.ts",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run tests/unit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
